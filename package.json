{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "silap-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write \"resources/**/*.{blade.php,js,css}\" \"vite.config.js\" \"*.json\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"resources/**/*.{blade.php,js,css}\" \"vite.config.js\" \"*.json\" \".github/workflows/*.{yml,yaml}\""
  },
  "devDependencies": {
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.10.1",
    "prettier-plugin-blade": "^3.3.3",
    "vite": "^8.0.0"
  }
}
